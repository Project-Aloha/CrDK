[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Lt9611Dxe
  FILE_GUID                      = 5f78bbc9-0f2b-417f-a773-74a8a28d85c0
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Lt9611EntryPoint

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = AARCH64
#

[Sources]
  lt9611.c
  Lt9611PanelOwner.c

[Packages]
  MdePkg/MdePkg.dec
  CranePkg/CranePkg.dec
  MUCommonCrPkg/MUCommonCrPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  CrDalLib
  BaseMemoryLib
  MemoryAllocationLib
  TimerLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiGpioCrProtocolGuid   # CONSUMER
  gEfiI2cCrProtocolGuid    # CONSUMER
  gEfiGpiCrProtocolGuid    # CONSUMER
  gEfiMdpDsiProtocolGuid   # CONSUMER
  gEfiMdssHandoffProtocolGuid # CONSUMER (HDK PCD only)
  gEfiLt9611CrProtocolGuid ## PRODUCES
  gEfiLt9611PanelCrProtocolGuid ## SOMETIMES_PRODUCES

[Depex]
  gEfiGpioCrProtocolGuid AND gEfiI2cCrProtocolGuid AND
  gEfiMdpDsiProtocolGuid

[Guids]
  gEfiEventReadyToBootGuid

[Pcd]
  gCranePkgTokenSpaceGuid.PcdMdssPanelProfile
  gCranePkgTokenSpaceGuid.PcdMdssHandoffEnable
  gCranePkgTokenSpaceGuid.PcdMdssHdkExtendedProfileEnable
