  MdeModulePkg/MdeModulePkg.dec
  CranePkg/CranePkg.dec

[LibraryClasses]
  PcdLib
  BaseMemoryLib
  CacheMaintenanceLib
  CrDalLib
  DebugLib
  IoLib
  DevicePathLib
  MemoryAllocationLib
