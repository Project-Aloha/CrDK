[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UfsHcCrDxe
  FILE_GUID                      = 5B8CE820-9F4F-4A9B-BE32-5F4C5C1D5A88
  MODULE_TYPE                    = DXE_DRIVER
