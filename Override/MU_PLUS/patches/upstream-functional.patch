+  IN USB_KB_HID_DEV *Device
+  )
+{
+  EFI_TPL OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  EFI_STATUS Status = EFI_NOT_READY;
+  if (!Device->Stopping) {
