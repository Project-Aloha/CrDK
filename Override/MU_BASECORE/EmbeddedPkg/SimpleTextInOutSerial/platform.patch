+/*
+ * SerialPortRead() is deliberately non-blocking.  A terminal can therefore
+ * split an escape sequence across two timer ticks (or two UART FIFO fills).
+ * Keep at most one three-byte ESC/CSI prefix pending so ReadKeyStroke() never
+ * consumes a prefix and then reports EFI_NOT_READY with that input lost.
+ */
+#define CONIN_PENDING_BYTES  3
+STATIC CHAR8  mConInPending[CONIN_PENDING_BYTES];
+STATIC UINTN  mConInPendingCount;
+
+STATIC
+BOOLEAN
+ReadConInByte (
+  OUT CHAR8  *Byte
+  )
+{
+  if ((Byte == NULL) || (mConInPendingCount > CONIN_PENDING_BYTES)) {
+    return FALSE;
+  }
+
+  if (mConInPendingCount != 0) {
+    *Byte = mConInPending[0];
+    if (mConInPendingCount > 1) {
+      CopyMem (
+        mConInPending,
+        mConInPending + 1,
+        mConInPendingCount - 1
+        );
+    }
+    mConInPendingCount--;
+    return TRUE;
+  }
+
+  return SerialPortRead ((UINT8 *)Byte, 1) == 1;
+}
+
+STATIC
+VOID
+PushConInBytes (
+  IN CONST CHAR8  *Bytes,
+  IN UINTN         Count
+  )
+{
+  UINTN Index;
+
+  if ((Bytes == NULL) || (Count == 0) ||
+      (Count > CONIN_PENDING_BYTES) ||
+      (mConInPendingCount + Count > CONIN_PENDING_BYTES)) {
+    return;
+  }
+
+  /* Move the old suffix out of the way, then prepend the saved prefix. */
+  if (mConInPendingCount != 0) {
+    CopyMem (
+      mConInPending + Count,
+      mConInPending,
+      mConInPendingCount
+      );
+  }
+  for (Index = 0; Index < Count; Index++) {
+    mConInPending[Index] = Bytes[Index];
+  }
+  mConInPendingCount += Count;
+}
+
