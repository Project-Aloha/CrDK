+  Instance->Busy = TRUE;
+  gBS->RestoreTPL (OldTpl);
+  Status = MmcResetWorker (This, ExtendedVerification);
+  gBS->RaiseTPL (TPL_NOTIFY);
+  Instance->Busy = FALSE;
