@@ -9,6 +9,53 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 
 #include "ConSplitter.h"
 
+/** Return TRUE only for an explicit primary-framebuffer console policy. */
+BOOLEAN
+ConSplitterPrimaryGopEnabled (
+  VOID
+  )
+{
+  CONST EFI_GUID  Empty = { 0 };
+
+  return !CompareGuid (FixedPcdGetPtr (PcdConSplitterPrimaryGopGuid), &Empty);
+}
+
+/** Copy the selected physical mode without sharing writable mode storage. */
+EFI_STATUS
+ConSplitterSyncPrimaryGop (
+  IN TEXT_OUT_SPLITTER_PRIVATE_DATA  *Private
+  )
+{
+  EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE  *Mode;
+  EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE  *PhysicalMode;
+  EFI_GRAPHICS_OUTPUT_MODE_INFORMATION  *Info;
+
+  Mode = Private->GraphicsOutput.Mode;
+  if (Mode == NULL || Mode->Info == NULL) {
+    return EFI_NOT_READY;
+  }
+
+  Info = Mode->Info;
+  PhysicalMode = Private->PrimaryGraphicsOutput == NULL ? NULL : Private->PrimaryGraphicsOutput->Mode;
+  if (PhysicalMode == NULL || PhysicalMode->Info == NULL ||
+      PhysicalMode->SizeOfInfo < sizeof (*Info) ||
+      PhysicalMode->MaxMode == 0 || PhysicalMode->Mode >= PhysicalMode->MaxMode) {
+    ZeroMem (Mode, sizeof (*Mode));
+    Mode->Info = Info;
+    ZeroMem (Info, sizeof (*Info));
+    Info->PixelFormat = PixelBltOnly;
+    Mode->SizeOfInfo = sizeof (*Info);
+    Mode->Mode = 0xffff;
+    return EFI_NOT_READY;
+  }
+
+  CopyMem (Mode, PhysicalMode, sizeof (*Mode));
+  Mode->Info = Info;
+  CopyMem (Info, PhysicalMode->Info, sizeof (*Info));
+  Mode->SizeOfInfo = sizeof (*Info);
+  return EFI_SUCCESS;
+}
