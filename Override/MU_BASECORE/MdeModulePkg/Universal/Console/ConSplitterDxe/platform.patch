+/** Select only the configured single vendor-node physical display path. */
+BOOLEAN
+ConSplitterIsPrimaryGop (
+  IN EFI_HANDLE  ControllerHandle
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Path;
+  CONST EFI_DEVICE_PATH_PROTOCOL  *End;
+  EFI_STATUS  Status;
+
+  if (ControllerHandle == NULL || !ConSplitterPrimaryGopEnabled ()) {
+    return FALSE;
+  }
+  Status = gBS->HandleProtocol (ControllerHandle, &gEfiDevicePathProtocolGuid, (VOID **)&Path);
+  if (Status != EFI_SUCCESS || Path == NULL ||
+      Path->Type != HARDWARE_DEVICE_PATH || Path->SubType != HW_VENDOR_DP ||
+      (Path->Length[0] | (Path->Length[1] << 8)) != sizeof (VENDOR_DEVICE_PATH)) {
+    return FALSE;
+  }
+  End = (CONST VOID *)((CONST UINT8 *)Path + sizeof (VENDOR_DEVICE_PATH));
+  return CompareGuid (&((CONST VENDOR_DEVICE_PATH *)Path)->Guid,
+                      FixedPcdGetPtr (PcdConSplitterPrimaryGopGuid)) &&
+         End->Type == END_DEVICE_PATH_TYPE && End->SubType == END_ENTIRE_DEVICE_PATH_SUBTYPE &&
+         (End->Length[0] | (End->Length[1] << 8)) == sizeof (*End);
+}
