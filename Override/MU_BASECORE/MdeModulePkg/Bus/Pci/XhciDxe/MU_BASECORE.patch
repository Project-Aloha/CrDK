+/** Close software writers only; the platform owns subsequent hardware retirement. */
+STATIC EFI_STATUS EFIAPI
+XhcFreeze (EDKII_USB2_HC_FREEZE_PROTOCOL *This, UINT32 *ActiveCalls)
+{
+  USB_XHCI_INSTANCE *Xhc;
+  EFI_TPL OldTpl;
+  if (This == NULL || ActiveCalls == NULL) return EFI_INVALID_PARAMETER;
+  Xhc = CR (This, USB_XHCI_INSTANCE, Freeze, XHCI_INSTANCE_SIG);
+  if (This->Revision != EDKII_USB2_HC_FREEZE_PROTOCOL_REVISION ||
+      This->HostController != &Xhc->Usb2Hc) return EFI_INVALID_PARAMETER;
+  OldTpl = gBS->RaiseTPL (XHC_TPL);
+  Xhc->Frozen = TRUE;
+  *ActiveCalls = Xhc->ActiveCalls;
+  gBS->RestoreTPL (OldTpl);
+  return *ActiveCalls == 0 ? EFI_SUCCESS : EFI_NOT_READY;
 }
 
