+// Failed Start and unpublished Stop instances stay reachable through Stop while their
+// PCI BY_DRIVER open prevents the parent and this image from being removed.
+STATIC USB_XHCI_INSTANCE *mXhcFailedStarts;
+
+STATIC
+USB_XHCI_INSTANCE *
+XhcFindFailedStart (
+  IN EFI_HANDLE Controller
+  )
+{
+  USB_XHCI_INSTANCE *Xhc;
+  for (Xhc = mXhcFailedStarts; Xhc != NULL; Xhc = Xhc->FailedNext) {
+    if (Xhc->FailedController == Controller) return Xhc;
+  }
+  return NULL;
+}
+
+STATIC
+EFI_STATUS
+XhcCleanupFailedStart (
+  IN EFI_DRIVER_BINDING_PROTOCOL *This,
+  IN USB_XHCI_INSTANCE *Xhc
+  )
+{
+  EFI_STATUS Status;
+  EFI_TPL OldTpl;
+  USB_XHCI_INSTANCE **Link;
+  OldTpl = gBS->RaiseTPL (XHC_TPL);
+  if (Xhc->Frozen || Xhc->ActiveCalls != 0) {
+    Status = EFI_NOT_READY;
+    goto DONE;
+  }
+  // Reset or Run may have failed after committing writes. A failed return does
+  // not establish that the hardware has stopped using its schedule.
+  if (Xhc->FailedHardwareTouched && !Xhc->FailedHalted) {
+    Status = XhcHaltHC (Xhc, XHC_GENERIC_TIMEOUT);
+    if (Status != EFI_SUCCESS) goto DONE;
+    XhcClearBiosOwnership (Xhc);
+    Xhc->FailedHalted = TRUE;
+  }
+  if (Xhc->PollTimer != NULL) {
+    Status = gBS->CloseEvent (Xhc->PollTimer);
+    if (Status != EFI_SUCCESS) goto DONE;
+    Xhc->PollTimer = NULL;
+  }
+  if (Xhc->ExitBootServiceEvent != NULL) {
+    Status = gBS->CloseEvent (Xhc->ExitBootServiceEvent);
+    if (Status != EFI_SUCCESS) goto DONE;
+    Xhc->ExitBootServiceEvent = NULL;
+  }
+  if (Xhc->FailedSlotsOwned) {
+    // This used to be a published controller. Both callbacks are now closed;
+    // retire slot/URB memory while PCI register access is still enabled.
+    XhcFreeDeviceSlots (Xhc);
+    XhciDelAllAsyncIntTransfers (Xhc);
+    if (!IsListEmpty (&Xhc->AsyncIntTransfers)) {
+      Status = EFI_NOT_READY;
+      goto DONE;
+    }
+    Xhc->FailedSlotsOwned = FALSE;
+  }
+  if (Xhc->FailedAttributesSaved && !Xhc->FailedAttributesRestored) {
+    Status = Xhc->PciIo->Attributes (Xhc->PciIo, EfiPciIoAttributeOperationSet,
+                                    Xhc->OriginalPciAttributes, NULL);
+    if (Status != EFI_SUCCESS) goto DONE;
+    Xhc->FailedAttributesRestored = TRUE;
+  }
+  Status = gBS->CloseProtocol (Xhc->FailedController, &gEfiPciIoProtocolGuid,
+                              This->DriverBindingHandle, Xhc->FailedController);
+  if (Status != EFI_SUCCESS) goto DONE;
+  // Still at TPL_NOTIFY: no parent teardown or polling can interleave between
+  // dropping the PCI open and freeing its stopped DMA allocations.
+  XhcFreeSched (Xhc);
+  if (Xhc->ControllerNameTable != NULL) FreeUnicodeStringTable (Xhc->ControllerNameTable);
+  for (Link = &mXhcFailedStarts; *Link != Xhc; Link = &(*Link)->FailedNext) {}
+  *Link = Xhc->FailedNext;
+  FreePool (Xhc);
+DONE:
+  gBS->RestoreTPL (OldTpl);
+  return Status == EFI_SUCCESS || EFI_ERROR (Status) ? Status : EFI_NOT_READY;
+}
