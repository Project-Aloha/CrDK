+// A failed Start must retain DMA ownership until HCE and mappings are fenced.
+// Retain independently per controller, retryable through either Start or Stop.
+STATIC EFI_STATUS
+UfsDiscoverLuns (UFS_PASS_THRU_PRIVATE_DATA *Private)
+{
+  EFI_STATUS Status;
+  UINT32                                 Index;
+  UFS_UNIT_DESC                          UnitDescriptor;
+  UFS_DEV_DESC                           DeviceDescriptor;
+  UINT32                                 UnitDescriptorSize;
+  UINT32                                 DeviceDescriptorSize;
+
+  Private->Luns.BitMask = 0;
+  //
+  // Check if 8 common luns are active and set corresponding bit mask.
+  //
+  for (Index = 0; Index < 8; Index++) {
+    UnitDescriptorSize = sizeof (UFS_UNIT_DESC);
+    ZeroMem (&UnitDescriptor, sizeof (UnitDescriptor));
+    Status = UfsRwDeviceDesc (Private, TRUE, UfsUnitDesc, (UINT8)Index, 0, &UnitDescriptor, &UnitDescriptorSize);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "Failed to read unit descriptor, index = %X, status = %r\n", Index, Status));
+      // Invalid Index/IDN identifies an absent LUN. Transport failures abort
+      // discovery instead of repeating a full timeout budget for every LUN.
+      if (Status != EFI_INVALID_PARAMETER) {
+        return Status;
+      }
+      continue;
+    }
+
+    // Linux ufshcd_read_desc_param validates header type/length before use.
+    if (UnitDescriptorSize <= OFFSET_OF (UFS_UNIT_DESC, LunEn) ||
+        UnitDescriptor.Length <= OFFSET_OF (UFS_UNIT_DESC, LunEn) ||
+        UnitDescriptor.DescType != UfsUnitDesc) continue;
+    if (UnitDescriptor.LunEn == 0x1) {
+      DEBUG ((DEBUG_INFO, "UFS LUN %X is enabled\n", Index));
+      Private->Luns.BitMask |= (BIT0 << Index);
+    }
+  }
+
+  //
+  // Check if RPMB WLUN is supported and set corresponding bit mask.
+  //
+  ZeroMem (&DeviceDescriptor, sizeof (DeviceDescriptor));
+  DeviceDescriptorSize = sizeof (UFS_DEV_DESC);
+  Status               = UfsRwDeviceDesc (Private, TRUE, UfsDeviceDesc, 0, 0, &DeviceDescriptor, &DeviceDescriptorSize);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "Failed to read device descriptor, status = %r\n", Status));
+    if (Status != EFI_INVALID_PARAMETER) {
+      return Status;
+    }
+  } else {
+    if (DeviceDescriptorSize > OFFSET_OF (UFS_DEV_DESC, SecurityLun) &&
+        DeviceDescriptor.Length > OFFSET_OF (UFS_DEV_DESC, SecurityLun) &&
+        DeviceDescriptor.DescType == UfsDeviceDesc &&
+        DeviceDescriptor.SecurityLun == 0x1) {
+      DEBUG ((DEBUG_INFO, "UFS WLUN RPMB is supported\n"));
+      Private->Luns.BitMask |= BIT11;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC UFS_PASS_THRU_PRIVATE_DATA *mFailedStart;
+
+STATIC UFS_PASS_THRU_PRIVATE_DATA *
+UfsFindRetained (EFI_HANDLE Controller)
+{
+  UFS_PASS_THRU_PRIVATE_DATA *Entry;
+  for (Entry = mFailedStart; Entry != NULL; Entry = Entry->RetainedNext) {
+    if (Entry->Handle == Controller) return Entry;
+  }
+  return NULL;
+}
+
+// This helper never owns caller lifetime or the queue node. A detached request
+// (Packet == NULL) can only release its private staging/mappings, never copy back.
+EFI_STATUS
+UfsReleaseRequestResources (UFS_PASS_THRU_PRIVATE_DATA *Private,
+                            UFS_PASS_THRU_TRANS_REQ *Request, BOOLEAN CopyRead)
+{
+  EFI_STATUS Status;
+  EDKII_UFS_HOST_CONTROLLER_PROTOCOL *Host = Private->UfsHostController;
+  if (Request->Submitted && !Request->DmaFenced) return EFI_NOT_READY;
+  if (Request->DataBufMapping != NULL) {
+    Status = Host->Unmap (Host, Request->DataBufMapping);
+    if (EFI_ERROR (Status)) return Status;
+    Request->DataBufMapping = NULL;
+  }
+  if (CopyRead && !Request->DataCopied && Request->ResponseValidated &&
+      Request->Packet != NULL && Request->AlignedDataBuf != NULL &&
+      Request->Packet->DataDirection == EFI_EXT_SCSI_DATA_DIRECTION_READ) {
+    if (Request->Packet->InTransferLength > Request->AlignedDataBufSize)
+      return EFI_COMPROMISED_DATA;
+    CopyMem (Request->Packet->InDataBuffer, Request->AlignedDataBuf,
+             Request->Packet->InTransferLength);
+    Request->DataCopied = TRUE;
+  }
+  if (Request->CmdDescFromPool) {
+    // Returning a fenced slot does not retire the controller-owned DMA pool.
+    Request->CmdDescHost = NULL;
+    Request->CmdDescFromPool = FALSE;
+  }
+  if (Request->CmdDescMapping != NULL) {
+    Status = Host->Unmap (Host, Request->CmdDescMapping);
+    if (EFI_ERROR (Status)) return Status;
+    Request->CmdDescMapping = NULL;
+  }
+  if (Request->CmdDescHost != NULL) {
+    Status = Host->FreeBuffer (Host, EFI_SIZE_TO_PAGES (Request->CmdDescSize), Request->CmdDescHost);
+    if (EFI_ERROR (Status)) return Status;
+    Request->CmdDescHost = NULL;
+  }
+  if (Request->AlignedDataBuf != NULL) {
+    ZeroMem (Request->AlignedDataBuf, Request->AlignedDataBufSize);
+    Status = Host->FreeBuffer (Host, EFI_SIZE_TO_PAGES (Request->AlignedDataBufSize), Request->AlignedDataBuf);
+    if (EFI_ERROR (Status)) return Status;
+    Request->AlignedDataBuf = NULL;
+  }
+  return EFI_SUCCESS;
+}
+
+// HCE is disabled before this path; request nodes without Packet/Event are
+// detached synchronous failures retained solely for private resource cleanup.
+STATIC EFI_STATUS
+UfsReleaseFencedRequest (UFS_PASS_THRU_PRIVATE_DATA *Private,
+                         UFS_PASS_THRU_TRANS_REQ *Request)
+{
+  EFI_STATUS Status;
+  Request->DmaFenced = TRUE;
+  Status = UfsReleaseRequestResources (Private, Request, FALSE);
+  if (EFI_ERROR (Status)) return Status;
+  if (Request->CallerEvent != NULL) {
+    Status = gBS->SignalEvent (Request->CallerEvent);
+    if (EFI_ERROR (Status)) return Status;
+  }
+  RemoveEntryList (&Request->TransferList);
+  if (Request->OwnsSlot) UfsReleaseSlot (Private, Request->Slot);
+  FreePool (Request);
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS
+UfsCleanupFailedStart (UFS_PASS_THRU_PRIVATE_DATA *Private)
+{
+  EFI_STATUS Status;
+  UFS_PASS_THRU_PRIVATE_DATA **Link;
+  LIST_ENTRY *Entry, *Next;
+  UFS_PASS_THRU_TRANS_REQ *Request;
+  EDKII_UFS_HOST_CONTROLLER_PROTOCOL *Host;
+  if (Private == NULL) return EFI_SUCCESS;
+  if (Private->CleanupInProgress) return EFI_NOT_READY;
+  Private->CleanupInProgress = TRUE;
+  Host = Private->UfsHostController;
+  if (Private->RetainedConfigInstalled) {
+    Status = gBS->UninstallMultipleProtocolInterfaces (
+                    Private->Handle, &gEfiUfsDeviceConfigProtocolGuid,
+                    &Private->UfsDevConfig, NULL);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->RetainedConfigInstalled = FALSE;
+  }
+  if (Private->TimerEvent != NULL) {
+    Status = gBS->SetTimer (Private->TimerEvent, TimerCancel, 0);
+    if (EFI_ERROR (Status)) goto Failed;
+    Status = gBS->CloseEvent (Private->TimerEvent);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->TimerEvent = NULL;
+  }
+  if (Private->RetainedControllerAttempted) {
+    Status = UfsControllerStop (Private);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->RetainedControllerAttempted = FALSE;
+  }
+  // Only signal/free queued requests after HCE disable has been confirmed.
+  BASE_LIST_FOR_EACH_SAFE (Entry, Next, &Private->Queue) {
+    Request = UFS_PASS_THRU_TRANS_REQ_FROM_THIS (Entry);
+    if (Request->Packet != NULL)
+      Request->Packet->HostAdapterStatus = EFI_EXT_SCSI_STATUS_HOST_ADAPTER_PHASE_ERROR;
+    Status = UfsReleaseFencedRequest (Private, Request);
+    if (EFI_ERROR (Status)) goto Failed;
+  }
+  if (Private->TmrlMapping != NULL) {
+    Status = Host->Unmap (Host, Private->TmrlMapping);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->TmrlMapping = NULL;
+  }
+  if (Private->UtpTmrlBase != NULL) {
+    Status = Host->FreeBuffer (Host, EFI_SIZE_TO_PAGES (Private->Nutmrs * sizeof (UTP_TMRD)), Private->UtpTmrlBase);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->UtpTmrlBase = NULL;
+  }
+  if (Private->TrlMapping != NULL) {
+    Status = Host->Unmap (Host, Private->TrlMapping);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->TrlMapping = NULL;
+  }
+  if (Private->UtpTrlBase != NULL) {
+    Status = Host->FreeBuffer (Host, EFI_SIZE_TO_PAGES (Private->Nutrs * sizeof (UTP_TRD)), Private->UtpTrlBase);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->UtpTrlBase = NULL;
+  }
+  // Every request has been fenced and released; retire the permanent UCD last.
+  if (Private->UcdMapping != NULL) {
+    Status = Host->Unmap (Host, Private->UcdMapping);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->UcdMapping = NULL;
+  }
+  if (Private->UtpUcdBase != NULL) {
+    Status = Host->FreeBuffer (Host, EFI_SIZE_TO_PAGES (Private->UcdPoolSize), Private->UtpUcdBase);
+    if (EFI_ERROR (Status)) goto Failed;
+    Private->UtpUcdBase = NULL;
+    Private->UcdPoolSize = 0;
+    Private->UcdDeviceAddress = 0;
+  }
+  Status = gBS->CloseProtocol (Private->Handle, &gEdkiiUfsHostControllerProtocolGuid,
+                              Private->RetainedAgent, Private->Handle);
+  if (EFI_ERROR (Status)) goto Failed;
+  for (Link = &mFailedStart; *Link != NULL; Link = &(*Link)->RetainedNext) {
+    if (*Link == Private) {
+      *Link = Private->RetainedNext;
+      break;
+    }
+  }
+  FreePool (Private);
+  return EFI_SUCCESS;
+Failed:
+  Private->CleanupInProgress = FALSE;
+  return Status;
+}
