<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <CRANE_CRDK_LIB_CLOCK_DIR>$(MSBuildThisFileDirectory)</CRANE_CRDK_LIB_CLOCK_DIR>
  </PropertyGroup>
  <PropertyGroup>
    <_PropertySheetDisplayName>ClockLib</_PropertySheetDisplayName>
    <IncludePath>$(CRANE_CRDK_LIB_CLOCK_DIR);$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)clock.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)clock_config.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)clock_votes.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)fixed_pll.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)gdsc.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_CLOCK_DIR)debugcc.c" />
  </ItemGroup>
</Project>
