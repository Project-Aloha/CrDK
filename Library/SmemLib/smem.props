<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <CRANE_CRDK_LIB_SMEM_DIR>$(MSBuildThisFileDirectory)</CRANE_CRDK_LIB_SMEM_DIR>
  </PropertyGroup>
  <PropertyGroup>
    <_PropertySheetDisplayName>SmemLib</_PropertySheetDisplayName>
    <IncludePath>$(CRANE_CRDK_LIB_SMEM_DIR);$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="$(CRANE_CRDK_LIB_SMEM_DIR)smem.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SMEM_DIR)smem_mutex.c" />
  </ItemGroup>
</Project>
