<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <CRANE_CRDK_LIB_SPMI_DIR>$(MSBuildThisFileDirectory)\</CRANE_CRDK_LIB_SPMI_DIR>
  </PropertyGroup>
  <PropertyGroup>
    <_PropertySheetDisplayName>Spmi</_PropertySheetDisplayName>
    <SourcePath>$(CRANE_CRDK_LIB_SPMI_DIR);$(SourcePath)</SourcePath>
    <IncludePath>$(SolutionDir);$(IncludePath);$(CRANE_CRDK_LIB_SPMI_DIR)</IncludePath>
  </PropertyGroup>
  <ItemGroup>
    <BuildMacro Include="CRANE_CRDK_LIB_SPMI_DIR">
      <Value>$(CRANE_CRDK_LIB_SPMI_DIR)</Value>
    </BuildMacro>
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/spmi.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/spmi_irq.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_common.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v1.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v2.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v3.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v5.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v7.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_SPMI_DIR)/pmic_arb_v8.c" />
  </ItemGroup>
</Project>
