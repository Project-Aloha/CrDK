[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CranePciHostBridgeLib
  FILE_GUID                      = 1f6c8f2b-6f3f-4ef1-bafc-04c4db11d6e6
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PciHostBridgeLib

[Sources]
  PciHostBridgeLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  CranePkg/CranePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DevicePathLib
  DebugLib
  IoLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  PcieLib
  CrDalLib

[Protocols]
  gEfiCrDalProtocolGuid         ## CONSUMES
  gEfiClockCrProtocolGuid       ## CONSUMES
  gEfiGpioCrProtocolGuid        ## CONSUMES
  gEfiInterconnectCrProtocolGuid ## CONSUMES
  gEfiRpmhCrProtocolGuid        ## CONSUMES
  gEfiSmmuCrProtocolGuid        ## CONSUMES

[Depex]
  gEfiCrDalProtocolGuid AND gEfiClockCrProtocolGuid AND
  gEfiGpioCrProtocolGuid AND gEfiInterconnectCrProtocolGuid AND
  gEfiRpmhCrProtocolGuid AND gEfiSmmuCrProtocolGuid
