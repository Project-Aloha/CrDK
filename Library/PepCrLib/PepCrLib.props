    <ClCompile Include="$(CRANE_CRDK_LIB_PEP_DIR)PepBandwidth.c" />
    <ClCompile Include="$(CRANE_CRDK_LIB_PEP_DIR)PepRail.c" />
  </ItemGroup>
</Project>
