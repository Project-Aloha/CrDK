# Offline public qcm6490 fixture profile; NEVER HDK8450 board configuration.
# audioreach-conf d9b13696adc1e0fd34a6ce8ef383763a981574b9
# qcom/qli/qcm6490/acdbdata/acdb_cal.acdb; key names in qcom/kvh2xml.h.
gkv 0xa1000000 0xa1000001
gkv 0xa2000000 0xa2000002
gkv 0xab000000 1
gkv 0xac000000 0xac000002
ckv 0xa4000000 0
format 48000 16 2
# Explicit offline example backend values; no board route qualification.
codec_dma 1 0 3
endpoint_tag 0xc0000004
transport 0x100 1 2 3
